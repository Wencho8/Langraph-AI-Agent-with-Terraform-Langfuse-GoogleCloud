# Local-only defaults. Never use these credentials for a deployed environment.
API_PORT=8088
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=local-chatbot-password
POSTGRES_DB=chatbot
APP_ENV=local
DEV_IDENTITY_ENABLED=true
MAX_ACTIVE_TURNS=4
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
TURN_TIMEOUT_SECONDS=30
MODEL_TIMEOUT_SECONDS=20
SIMULATED_CHUNK_DELAY_SECONDS=0.04
MODEL=simulated
# When ready, set MODEL=openai:gpt-6.1-terra (or another model ID) and your key
OPENAI_API_KEY=
MODEL_MAX_OUTPUT_TOKENS=2048
TOOL_TIMEOUT_SECONDS=5
MAX_MODEL_CALLS=4
MAX_TOOL_CALLS=8
GRAPH_RECURSION_LIMIT=12
