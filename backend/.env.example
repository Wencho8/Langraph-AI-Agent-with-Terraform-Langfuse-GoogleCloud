# Backend settings. Real credentials belong only in the ignored backend/.env.
# Local Compose ports/database; Cloud Run/Cloud SQL will use deployed configuration.
API_PORT=8088
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=local-chatbot-password
POSTGRES_DB=chatbot
# Compose always uses direct access to the local db service, never Cloud SQL.
DATABASE_POOL_SIZE=6
DATABASE_CONNECT_TIMEOUT_SECONDS=10
# Future Cloud Run configuration (not needed locally):
# DATABASE_MODE=cloud_sql
# CLOUD_SQL_INSTANCE=<project>:<region>:<instance>
# DATABASE_NAME=chatbot
# DATABASE_USER=<service-account-name>@<project>.iam
# Do not set DATABASE_URL in cloud_sql mode; IAM replaces database passwords.
APP_ENV=local
AUTH_MODE=session
# Public frontend origin. Set the actual HTTPS URL in staging/production.
APP_ORIGIN=http://localhost:5173
# Defaults below can be omitted unless you want to override them.
SESSION_TTL_SECONDS=86400
AUTH_LOGIN_LIMIT=10
AUTH_REGISTRATION_LIMIT=5
MAX_ACTIVE_TURNS=4
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
TURN_TIMEOUT_SECONDS=240
MODEL_TIMEOUT_SECONDS=120
SIMULATED_CHUNK_DELAY_SECONDS=0.04
MODEL=simulated
# When ready: MODEL=openai:gpt-6.1-terra and your key
OPENAI_API_KEY=
MODEL_MAX_OUTPUT_TOKENS=8192
TOOL_TIMEOUT_SECONDS=10
MAX_MODEL_CALLS=4
MAX_TOOL_CALLS=8
GRAPH_RECURSION_LIMIT=12

MODEL_REASONING_EFFORT=high
# Enable iol locally after supplying credentials; disabled needs no broker account.
MARKET_DATA_PROVIDER=disabled
# JSON username/password; single-quote the JSON in .env to preserve dollar signs.
IOL_CREDENTIALS=
