# Backend settings. Real credentials belong only in the ignored backend/.env.
# Local Compose ports/database; Cloud Run/Cloud SQL will use deployed configuration.
API_PORT=8088
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=local-chatbot-password
POSTGRES_DB=chatbot
APP_ENV=local
AUTH_MODE=session
# Public frontend origin. Set the actual HTTPS URL in staging/production.
APP_ORIGIN=http://localhost:5173
# Defaults below can be omitted unless you want to override them.
SESSION_TTL_SECONDS=86400
SESSION_COOKIE_SECURE=false
AUTH_LOGIN_LIMIT=10
AUTH_REGISTRATION_LIMIT=5
MAX_ACTIVE_TURNS=4
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
TURN_TIMEOUT_SECONDS=30
MODEL_TIMEOUT_SECONDS=20
SIMULATED_CHUNK_DELAY_SECONDS=0.04
MODEL=simulated
# When ready: MODEL=openai:gpt-6.1-terra and your key
OPENAI_API_KEY=
MODEL_MAX_OUTPUT_TOKENS=2048
TOOL_TIMEOUT_SECONDS=5
MAX_MODEL_CALLS=4
MAX_TOOL_CALLS=8
GRAPH_RECURSION_LIMIT=12
